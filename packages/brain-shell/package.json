    "ink": "^5.1.0",
    "lodash-es": "^4.18.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-reconciler": "^0.31.0",
    "semver": "^7.8.5",
    "signal-exit": "^4.1.0",
