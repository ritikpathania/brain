{
  "name": "@brain/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "First-party Brain terminal frontend",
  "scripts": {
    "start": "bun run src/cli/main.ts",
    "build": "bun run scripts/build.ts",
    "test": "bun run test:unit",
    "test:unit": "bun test tests/protocol tests/state tests/integration tests/presentation",
    "test:protocol": "bun test tests/protocol tests/state tests/integration",
    "test:e2e": "bun test tests/e2e",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "7.1.1",
    "react": "19.2.8",
    "string-width": "8.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.2.8",
    "react-devtools-core": "7.0.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
