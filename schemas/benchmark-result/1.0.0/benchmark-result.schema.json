{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ritikpathania/brain/main/schemas/benchmark-result/1.0.0/benchmark-result.schema.json",
  "title": "BenchmarkResult",
  "description": "Canonical machine-readable interchange schema contract across all specialized Quality Architecture benchmark suites (EBRA, RQB, Agent, OPB).",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "metadata",
    "benchmark",
    "measurements",
    "evidence",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "kind": {
      "type": "string",
      "const": "BenchmarkResult"
    },
    "metadata": { "$ref": "#/$defs/Metadata" },
    "benchmark": { "$ref": "#/$defs/BenchmarkInfo" },
    "measurements": { "$ref": "#/$defs/Measurements" },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provenance": { "$ref": "#/$defs/Provenance" },
    "diagnostics": { "$ref": "#/$defs/Diagnostics" },
    "recommendations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "Metadata": {
      "type": "object",
      "required": ["suite_id", "benchmark_id"],
      "properties": {
        "suite_id": { "type": "string", "enum": ["EBRA", "RQB", "Agent", "OPB"] },
        "benchmark_id": { "type": "string" },
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|\\+[0-9]{2}:[0-9]{2})?$"
        }
      }
    },
    "BenchmarkInfo": {
      "type": "object",
      "required": ["capability", "status"],
      "properties": {
        "capability": { "type": "string" },
        "status": { "type": "string", "enum": ["PASS", "QUALITY_WARNING", "ENGINE_FAIL", "BLOCKED"] }
      }
    },
    "Measurements": {
      "type": "object",
      "required": ["score"],
      "properties": {
        "score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "confidence": { "$ref": "#/$defs/Confidence" },
        "latency": { "$ref": "#/$defs/Latency" }
      }
    },
    "Confidence": {
      "type": "object",
      "properties": {
        "lower": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "upper": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "level": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "Latency": {
      "type": "object",
      "properties": {
        "mean_ms": { "type": "number", "minimum": 0.0 },
        "p50_ms": { "type": "number", "minimum": 0.0 },
        "p95_ms": { "type": "number", "minimum": 0.0 },
        "p99_ms": { "type": "number", "minimum": 0.0 }
      }
    },
    "Provenance": {
      "type": "object",
      "required": ["git_commit"],
      "properties": {
        "git_commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,40}$" },
        "policy_hash": { "type": "string" },
        "seed": { "type": "integer" }
      }
    },
    "Diagnostics": {
      "type": "object",
      "properties": {
        "probable_causes": { "type": "array", "items": { "type": "string" } },
        "suggested_capability": { "type": "string" }
      }
    }
  }
}
