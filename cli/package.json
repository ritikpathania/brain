{
  "name": "brain-cli",
  "version": "0.1.0",
  "module": "src/main.tsx",
  "type": "module",
  "bin": {
    "brain": "./bin/brain-wrapper.js"
  },
  "scripts": {
    "start": "bun run src/main.tsx",
    "build": "bun build src/main.tsx --outfile dist/cli.js --bundle --target=node --minify --external=react-devtools-core",
    "postinstall": "bun run build && PYO3_PYTHON=$(pwd)/../daemon/.venv/bin/python cargo build --release --manifest-path ../daemon/Cargo.toml && mkdir -p bin && cp ../daemon/target/release/brain bin/brain || true",
    "benchmark:render": "bun run src/benchmark_render.tsx",
    "benchmark:compare": "bun run src/benchmark_compare.ts"
  },
  "dependencies": {
    "react": "^18.2.0",
    "ink": "^4.4.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "bun-types": "^1.1.0",
    "ink-testing-library": "^3.0.0",
    "react-devtools-core": "^7.0.1"
  }
}
