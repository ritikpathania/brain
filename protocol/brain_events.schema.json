{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Brain Ingestion Event Schema",
  "description": "Formal schema for transport-neutral canonical ingestion events in Brain",
  "type": "object",
  "$ref": "#/$defs/IngestionEnvelope",
  "$defs": {
    "IngestionEnvelope": {
      "type": "object",
      "properties": {
        "event_model_version": {
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/EventIdentity"
        },
        "event": {
          "$ref": "#/$defs/IngestionEvent"
        }
      },
      "required": ["event_model_version", "identity", "event"],
      "additionalProperties": false
    },
    "EventIdentity": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "parent_event_id": {
          "oneOf": [
            { "type": "string", "format": "uuid" },
            { "type": "null" }
          ]
        },
        "workspace_id": {
          "type": "string"
        },
        "client_id": {
          "type": "string"
        },
        "adapter_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "conversation_id": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "event_id",
        "workspace_id",
        "client_id",
        "adapter_id",
        "session_id",
        "timestamp"
      ],
      "additionalProperties": false
    },
    "Value": {
      "description": "A transport-agnostic JSON/CBOR-compatible value tree.",
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/Value" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/Value" }
        }
      ]
    },
    "EventMetadata": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Value"
      }
    },
    "Capability": {
      "type": "string",
      "enum": [
        "conversation_messages",
        "conversation_tools",
        "workspace_git",
        "workspace_files",
        "workspace_terminal",
        "workspace_diagnostics",
        "replay",
        "batching"
      ]
    },
    "IngestionEvent": {
      "type": "object",
      "properties": {
        "event_type": {
          "type": "string"
        }
      },
      "required": ["event_type"],
      "oneOf": [
        {
          "properties": {
            "event_type": { "const": "message" },
            "role": { "type": "string", "enum": ["user", "assistant", "system"] },
            "content": { "type": "string" },
            "metadata": { "$ref": "#/$defs/EventMetadata" }
          },
          "required": ["event_type", "role", "content", "metadata"],
          "additionalProperties": false
        },
        {
          "properties": {
            "event_type": { "const": "tool_call" },
            "call_id": { "type": "string" },
            "tool_name": { "type": "string" },
            "arguments": { "$ref": "#/$defs/Value" },
            "metadata": { "$ref": "#/$defs/EventMetadata" }
          },
          "required": ["event_type", "call_id", "tool_name", "arguments", "metadata"],
          "additionalProperties": false
        },
        {
          "properties": {
            "event_type": { "const": "tool_result" },
            "call_id": { "type": "string" },
            "output": { "type": "string" },
            "is_error": { "type": "boolean" },
            "metadata": { "$ref": "#/$defs/EventMetadata" }
          },
          "required": ["event_type", "call_id", "output", "is_error", "metadata"],
          "additionalProperties": false
        },
        {
          "properties": {
            "event_type": { "const": "file_edit" },
            "path": { "type": "string" },
            "diff": {
              "oneOf": [
                { "type": "string" },
                { "type": "null" }
              ]
            },
            "metadata": { "$ref": "#/$defs/EventMetadata" }
          },
          "required": ["event_type", "path", "metadata"],
          "additionalProperties": false
        },
        {
          "properties": {
            "event_type": { "const": "diagnostic" },
            "severity": { "type": "string", "enum": ["error", "warning", "info", "hint"] },
            "message": { "type": "string" },
            "source": { "type": "string" },
            "file": {
              "oneOf": [
                { "type": "string" },
                { "type": "null" }
              ]
            },
            "line": {
              "oneOf": [
                { "type": "integer" },
                { "type": "null" }
              ]
            },
            "metadata": { "$ref": "#/$defs/EventMetadata" }
          },
          "required": ["event_type", "severity", "message", "source", "metadata"],
          "additionalProperties": false
        },
        {
          "properties": {
            "event_type": { "const": "terminal_command" },
            "command": { "type": "string" },
            "exit_code": {
              "oneOf": [
                { "type": "integer" },
                { "type": "null" }
              ]
            },
            "stdout_summary": {
              "oneOf": [
                { "type": "string" },
                { "type": "null" }
              ]
            },
            "metadata": { "$ref": "#/$defs/EventMetadata" }
          },
          "required": ["event_type", "command", "metadata"],
          "additionalProperties": false
        },
        {
          "properties": {
            "event_type": { "const": "git_commit" },
            "hash": { "type": "string" },
            "message": { "type": "string" },
            "branch": {
              "oneOf": [
                { "type": "string" },
                { "type": "null" }
              ]
            },
            "files_changed": {
              "type": "array",
              "items": { "type": "string" }
            },
            "metadata": { "$ref": "#/$defs/EventMetadata" }
          },
          "required": ["event_type", "hash", "message", "files_changed", "metadata"],
          "additionalProperties": false
        },
        {
          "properties": {
            "event_type": { "const": "git_branch" },
            "action": { "type": "string" },
            "branch_name": { "type": "string" },
            "metadata": { "$ref": "#/$defs/EventMetadata" }
          },
          "required": ["event_type", "action", "branch_name", "metadata"],
          "additionalProperties": false
        },
        {
          "properties": {
            "event_type": { "const": "session_started" },
            "metadata": { "$ref": "#/$defs/EventMetadata" }
          },
          "required": ["event_type", "metadata"],
          "additionalProperties": false
        },
        {
          "properties": {
            "event_type": { "const": "session_ended" },
            "metadata": { "$ref": "#/$defs/EventMetadata" }
          },
          "required": ["event_type", "metadata"],
          "additionalProperties": false
        },
        {
          "properties": {
            "event_type": { "const": "adapter_connected" },
            "adapter_version": { "type": "string" },
            "supported_event_model_versions": {
              "type": "array",
              "items": { "type": "string" }
            },
            "supported_serializations": {
              "type": "array",
              "items": { "type": "string" }
            },
            "capabilities": {
              "type": "array",
              "items": { "$ref": "#/$defs/Capability" }
            },
            "metadata": { "$ref": "#/$defs/EventMetadata" }
          },
          "required": [
            "event_type",
            "adapter_version",
            "supported_event_model_versions",
            "supported_serializations",
            "capabilities",
            "metadata"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "event_type": { "const": "adapter_disconnected" },
            "reason": {
              "oneOf": [
                { "type": "string" },
                { "type": "null" }
              ]
            },
            "metadata": { "$ref": "#/$defs/EventMetadata" }
          },
          "required": ["event_type", "metadata"],
          "additionalProperties": false
        },
        {
          "properties": {
            "event_type": { "const": "text" },
            "content": { "type": "string" },
            "metadata": { "$ref": "#/$defs/EventMetadata" }
          },
          "required": ["event_type", "content", "metadata"],
          "additionalProperties": false
        }
      ]
    }
  }
}
