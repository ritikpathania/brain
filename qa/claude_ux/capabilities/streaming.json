[
  {
    "id": "streaming.prompt_submission",
    "name": "Prompt Submission & Turn Dispatch",
    "category": "streaming",
    "user_action": "Press Enter with non-empty input in PromptInput",
    "frontend": [
      "PromptInput",
      "REPL",
      "handlePromptSubmit"
    ],
    "state_transition": "Appends UserMessage to state -> locks queryGuard -> triggers onQuery",
    "orchestration": [
      "handlePromptSubmit.ts::executeUserInput()",
      "REPL.tsx::onQuery()"
    ],
    "runtime_services": [
      "messages.ts::createUserMessage()"
    ],
    "backend": [
      "Query Loop / CallModel"
    ],
    "events": [
      "stream_request_start"
    ],
    "state_mutation": "setMessages(prev => [...prev, userMsg]), setStreamMode(requesting)",
    "rendered_ui": "User message box added to Messages list; spinner starts requesting",
    "persistence": [
      "Session transcript"
    ],
    "classification": "KEEP",
    "rationale": "Standard UI submission flow; drives message list state.",
    "seam_impact": "Seam: onQuery delegates to QueryDeps.callModel."
  },
  {
    "id": "streaming.token_delta_stream",
    "name": "Incremental Text Streaming & Typewriter Queue",
    "category": "streaming",
    "user_action": "Model streams response chunks",
    "frontend": [
      "REPL",
      "StreamingMarkdown",
      "Spinner",
      "Messages"
    ],
    "state_transition": "StreamEvent(content_block_delta) -> handleMessageFromStream",
    "orchestration": [
      "query.ts::queryLoop()",
      "query/deps.ts::callModel"
    ],
    "runtime_services": [
      "utils/messages.ts::handleMessageFromStream()"
    ],
    "backend": [
      "Brain Engine Text Stream"
    ],
    "events": [
      "content_block_start",
      "content_block_delta",
      "content_block_stop"
    ],
    "state_mutation": "streamingText += chunk, setStreamMode(responding)",
    "rendered_ui": "Live markdown token stream rendered with typing animation",
    "persistence": [],
    "classification": "REPLACE",
    "rationale": "Backend text generation replaced by Brain; frontend rendering completely preserved.",
    "seam_impact": "Seam: QueryDeps.callModel yields StreamEvent::content_block_delta."
  },
  {
    "id": "streaming.turn_completion",
    "name": "Turn Completion & Final Message Materialization",
    "category": "streaming",
    "user_action": "Model generation ends (message_stop)",
    "frontend": [
      "REPL",
      "Messages",
      "VirtualMessageList"
    ],
    "state_transition": "Yields AssistantMessage -> setMessages -> clears streamingText",
    "orchestration": [
      "query.ts::queryLoop()",
      "query/deps.ts::callModel"
    ],
    "runtime_services": [
      "utils/messages.ts::handleMessageFromStream()"
    ],
    "backend": [
      "Brain Turn Finished Payload"
    ],
    "events": [
      "message_delta",
      "message_stop",
      "AssistantMessage"
    ],
    "state_mutation": "setMessages(prev => [...prev, assistantMsg]), setStreamingText(null)",
    "rendered_ui": "Solidified AssistantMessage block in VirtualMessageList; prompt restored",
    "persistence": [
      "Session transcript / database"
    ],
    "classification": "REPLACE",
    "rationale": "Assistant message generated by Brain model turn.",
    "seam_impact": "Seam: QueryDeps.callModel yields final AssistantMessage."
  },
  {
    "id": "streaming.cancellation_ctrl_c",
    "name": "Turn Interruption & Stream Cancellation",
    "category": "streaming",
    "user_action": "Press Ctrl+C or submit new prompt while turn is streaming",
    "frontend": [
      "REPL",
      "PromptInput"
    ],
    "state_transition": "abortController.abort() -> signals AbortSignal.aborted = true",
    "orchestration": [
      "REPL.tsx::handleAbort()",
      "query.ts::query()"
    ],
    "runtime_services": [
      "utils/messages.ts::yieldMissingToolResultBlocks()"
    ],
    "backend": [
      "Brain Backend Stream Drop / Cancellation Token"
    ],
    "events": [
      "stream_cancelled"
    ],
    "state_mutation": "setStreamMode(idle), clears transient tool states",
    "rendered_ui": "Inline [Interrupted by user] note; prompt input re-enabled",
    "persistence": [
      "Session transcript"
    ],
    "classification": "ADAPT",
    "rationale": "AbortSignal listener mapped to Brain stream cancellation.",
    "seam_impact": "Seam: QueryDeps.callModel signal listener drops Brain subscription."
  }
]